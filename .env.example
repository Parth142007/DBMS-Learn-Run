# ==============================================================================
# DBMS Learn & Run — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Database Connection (Local MySQL or Managed Cloud MySQL)
# For Local MySQL: use localhost / 3306
# For Cloud MySQL (e.g. TiDB Serverless, Aiven, Supabase, AWS RDS):
# provide your remote host and set MYSQL_SSL_DISABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=dbms_learn_run

# Optional SSL Settings for Cloud MySQL (leave disabled for localhost)
MYSQL_SSL_DISABLED=false
MYSQL_SSL_CA=

# Application Execution & Safety Limits
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS_RETURNED=200

# Flask Application Settings
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-key
PORT=5000

# AI Provider Configuration (Optional — users can also Bring-Your-Own-Key in the UI)
# Option 1: Direct Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenRouter API Key (from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
